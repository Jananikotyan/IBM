
# ════════════════════════════════════════════════════════
#  Sehat Saathi — Environment Configuration
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════

# ── MODE SELECTOR ─────────────────────────────────────
# Set ONE of these to true:
#   MOCK_MODE=true    → fully offline, zero API keys needed
#   OLLAMA_MODE=true  → Ollama local LLM + Groq API (recommended)
#   both false        → IBM watsonx.ai (original)
MOCK_MODE=false
OLLAMA_MODE=true

# ── OLLAMA (Local Granite LLM) ────────────────────────
# Install Ollama from https://ollama.com  (free, no account)
# Then run: ollama pull granite3.1-dense:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.1-dense:2b

# ── GROQ API (Translation + Whisper STT) ─────────────
# Sign up free at https://console.groq.com
# One key covers both translation (LLaMA) and STT (Whisper)
GROQ_API_KEY=your_groq_api_key_here
# Use the model available on your Groq account
# Check available models at: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── GOOGLE PLACES (optional facility locator) ─────────
# Leave blank to use free OpenStreetMap fallback
GOOGLE_PLACES_API_KEY=

# ── IBM watsonx.ai (optional — original stack) ────────
# Only needed if OLLAMA_MODE=false and MOCK_MODE=false
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── IBM Watson Translator (optional — original stack) ─
WATSON_TRANSLATOR_API_KEY=
WATSON_TRANSLATOR_URL=

# ── IBM Watson Speech-to-Text (optional — /voice API endpoint) ──
# Only needed if you use the Watson STT route in routes.py.
# The Streamlit frontend uses Groq Whisper instead (no extra key needed).
WATSON_STT_API_KEY=
WATSON_STT_URL=

# ── Telegram Bot (FREE — easiest setup, just need phone) ────
# No website account needed — just Telegram app on your phone
# 1. Open Telegram → search @BotFather → send /newbot
# 2. Follow prompts → copy the token it gives you
# 3. Paste it below → run python main.py → bot is live!
TELEGRAM_BOT_TOKEN=

# ── Meta WhatsApp Cloud API (FREE — recommended) ─────
# Official Meta API — no credit card, 1000 free conversations/month
# Setup guide: https://developers.facebook.com → Create App → WhatsApp
#
# Step 1: Create app at developers.facebook.com (free)
# Step 2: Add WhatsApp product → get a free test phone number
# Step 3: Copy "Temporary access token" → META_WHATSAPP_TOKEN
# Step 4: Copy "Phone number ID"        → META_PHONE_NUMBER_ID
# Step 5: Choose any secret string      → META_WHATSAPP_VERIFY_TOKEN
# Step 6: Run ngrok → paste URL into Meta webhook settings
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=sehat_saathi_verify

# ── Twilio WhatsApp (legacy — optional, paid) ─────────
# Only needed if you use the old Twilio integration
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── App Config ────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
VECTOR_DB_PATH=./data/vector_store
DOCS_PATH=./data/knowledge_base

# ── Tuning (optional — sensible defaults built-in) ────
# How many past turns the agent remembers per session (default: 10)
# CONVERSATION_MEMORY_K=10
# HuggingFace embedding model for RAG (default: all-MiniLM-L6-v2)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
