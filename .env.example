# IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Language Translator
WATSON_TRANSLATOR_API_KEY=your_translator_api_key_here
WATSON_TRANSLATOR_URL=https://api.us-south.language-translator.watson.cloud.ibm.com/instances/your_instance_id

# IBM Watson Speech-to-Text (optional)
WATSON_STT_API_KEY=your_stt_api_key_here
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/your_instance_id

# Facility Locator
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Infermedica (optional symptom validation)
INFERMEDICA_APP_ID=your_infermedica_app_id_here
INFERMEDICA_APP_KEY=your_infermedica_app_key_here

# App Config
APP_ENV=development
LOG_LEVEL=INFO
VECTOR_DB_PATH=./data/vector_store
DOCS_PATH=./data/knowledge_base

# Demo / Mock Mode — set to true to run WITHOUT any IBM or Google API keys
# All tools (triage, vaccines, facility locator, safety layer) still work
# LLM responses are replaced with a smart rule-based engine
MOCK_MODE=false
